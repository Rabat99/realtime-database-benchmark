# Container-Images und Datenbank
POSTGRES_IMAGE=postgres:16
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=benchmark_pw
POSTGRES_DB=chat
POSTGRES_PORT=55435
POSTGRES_META_PORT=55436

# PostgreSQL-Konfiguration der Messumgebung
PG_SHARED_BUFFERS=1GB
PG_WORK_MEM=16MB

# Hasura
HASURA_ADMIN_SECRET=benchmarksecret
HASURA_PORT=8080

# Zero
ZERO_PORT=4848
ZERO_ADMIN_PASSWORD=benchmarksecret
ZERO_LOG_LEVEL=info

# CPU-Zuordnung des Ein-Kern-Basisprofils
PG_CPUS=0
HASURA_CPUS=1
ZERO_CPUS=1
HARNESS_CPUS=2,3
COORDINATOR_CPUS=2,3
